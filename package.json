{
  "name": "ai-office-assistant",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "release": "tsc --noEmit && vite build --config vite.standalone.config.ts && node scripts/build-standalone.js",
    "release:publish": "node scripts/publish-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "manifest": "node scripts/build-manifest.js"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "katex": "^0.16.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/jspdf": "^1.3.3",
    "@types/katex": "^0.16.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
